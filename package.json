{
  "name": "orion-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:bundle:release": "./scripts/android-bundle-release.sh",
    "android:build:release": "npm run android:prebuild && npm run android:bundle:release",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:pods": "cd ios && pod install --repo-update",
    "ios:open": "xed ios",
    "ios:build:prep": "npm run ios:prebuild && npm run ios:pods && npm run ios:open",
    "ios:clean": "pkill -f \"expo start\" || true; pkill -f metro || true; rm -rf .expo; expo start -c --host lan --port 8083 --ios",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.11.0",
    "axios": "^1.7.9",
    "expo": "^55.0.0",
    "expo-application": "~55.0.14",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.17",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-local-authentication": "~55.0.13",
    "expo-localization": "~55.0.13",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-video": "~55.0.15",
    "expo-video-thumbnails": "~55.0.14",
    "expo-web-browser": "~55.0.14",
    "i18next": "^25.8.0",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.37.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.5.4",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@sentry/cli": "^3.3.3",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
